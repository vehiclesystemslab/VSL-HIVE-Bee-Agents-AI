After=network.target

[Service]
Type=simple
User=andresborda
WorkingDirectory=/home/andresborda/hive-jp02-nra
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/andresborda/hive-jp02-nra/reference/vsl_hive_nra_core_reference_v0_1.py
